@using CustomerOrder.Models.ViewModels.Customers
@model CustomerRemoveViewModel

<h1>Customer Detail</h1>

<table class="table table-hover table-bordered table-striped">
    <thead>
   
        <tr>
            <th scope="col">Name</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th scope="col">Phone</th>
            <td>@Model.PhoneNo</td>
        </tr>
        <tr>
            <th scope="col">Address</th>
            <td>@Model.Address</td>
        </tr>
        


    </thead>

    @* <tbody><tr><a class="btn btn-secondary">Close</a></tr></tbody> *@
    
</table>
@* <a class="btn btn-secondary" href="~/customer/index">Close</a>
<a class="btn btn-danger" asp-action="Remove" asp-route-id="@Model.Id">Remove</a> *@


<form asp-action="RemoveConfirmation" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this customer?');">
    <button type="submit" class="btn btn-danger">Remove</button>
</form>
<a class="btn btn-secondary" href="~/customer/index">Cancel</a>